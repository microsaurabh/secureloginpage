NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/secure-login-portal
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_TTL_DAYS=30
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=secure-login-portal
SMTP_PASSWORD=change-me
EMAIL_FROM=no-reply@example.com
